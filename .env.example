# ═══════════════════════════════════════════════════════════════════════
# ChangeLens AI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════

# ── Gemini (LLM + embeddings) — Phase 2+ ───────────────────────────────
# Obtain from https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=

# Text model. Default is a current GA model (Aug 2026); verify against the
# models available to your API account: https://ai.google.dev/gemini-api/docs/models
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Embedding model (current GA: gemini-embedding-2; text-embedding-004 is retired).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── Embedding provider (Phase 3+) ───────────────────────────────────────
# gemini = use Gemini embedding API (demo / real retrieval)
# mock   = deterministic local vectors (offline dev, unit tests, $0)
EMBEDDING_PROVIDER=gemini
# Dimension must match the embedding model (gemini-embedding-2 -> 768 recommended;
# the retired text-embedding-004 is never a default). A model/dimension change
# requires re-indexing (docs/llm-integration.md §2).
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
# Automatically run hybrid retrieval to fill the evidence package (Phase 3).
AI_AUTO_RETRIEVE=true
# Context budget for the evidence package rendered into the prompt (Phase 4).
AI_MAX_EVIDENCE_CHUNKS=20
AI_MAX_CHARS_PER_CHUNK=12000
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=50
RRF_K=60

# ── PostgreSQL (single instance, two schemas: app + ai) ────────────────
# The docker-compose.yml at the repo root reads these for the container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=changelens
POSTGRES_PASSWORD=changelens_dev_password
POSTGRES_DB=changelens

# ── Backend (ASP.NET Core 10) — Phase 1 ─────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
# Connection string for EF Core (docker-compose sets it for the backend in
# Phase 9). When using scripts/start-local-postgres.sh (no Docker) change the
# port to 5433:
#   ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;...
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=changelens;Username=changelens;Password=changelens_dev_password

# AI service base URL (Phase 2+; docker-compose: http://ai-service:8000)
AI_SERVICE_BASE_URL=http://localhost:8000
# The backend reads these two directly (ASP.NET config binding):
#   Ai__BaseUrl / Ai__ApiKey
# The python service reads AI_SERVICE_BASE_URL for its own purposes and requires
# INTERNAL_API_KEY on every /internal/v1/* call.
Ai__BaseUrl=http://localhost:8000
# Shared secret the AI service requires on /internal/v1/* calls (Phase 2+)
INTERNAL_API_KEY=change-me-internal-key
Ai__ApiKey=change-me-internal-key

# ── Async analysis jobs (Phase 5, backend worker) ───────────────────────
# Bounded in-process queue + background worker; concurrency caps free-tier AI spend.
Analysis__QueueCapacity=100
Analysis__MaxConcurrency=2
Analysis__JobTimeoutSeconds=600
Analysis__MaxRetries=2
Analysis__RetryBackoffSeconds=5
Analysis__RecoverOnStartup=true

# ── AI service (FastAPI, Phase 2) ────────────────────────────────────────
# Provider: "gemini" (real LLM) or "mock" (deterministic local stand-in, $0).
AI_PROVIDER=gemini
# Provider call timeout + bounded retries (429/5xx only, exponential backoff + jitter).
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=8192
# Optional per-model pricing (USD per 1M tokens). Unset => no cost estimate returned.
GEMINI_INPUT_PRICE_PER_1M_USD=
GEMINI_OUTPUT_PRICE_PER_1M_USD=
# Bounded structured-output repair attempts; readiness probe (off by default — health
# must never consume Gemini tokens).
AI_MAX_REPAIR_ATTEMPTS=2
AI_READINESS_PROBE=false

# ── Auth (JWT, dev defaults — replace before any shared deployment) ────
JWT__ISSUER=changelens-dev
JWT__AUDIENCE=changelens-client
# Dev-only signing key; use a strong random value (or managed secrets) outside local dev
JWT__SIGNING_KEY=dev-only-signing-key-0123456789abcdef0123456789abcdef
JWT__EXPIRY_MINUTES=480

# ── Frontend (Phase 6+) ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── Tests (integration) ─────────────────────────────────────────────────
# When set, integration tests use this existing PostgreSQL instead of
# starting a Testcontainers container (needed on machines without Docker).
# CHANGELENS_TEST_CONNECTION_STRING=Host=localhost;Port=5433;Database=changelens_test;Username=changelens;Password=
