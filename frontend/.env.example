# ChangeLens frontend — environment template (copy to .env.local and adjust).
#
# VITE_* variables are inlined into the browser bundle and are PUBLIC.
# NEVER put GEMINI_API_KEY, JWT secrets, or credentials here — the frontend
# only ever talks to the ASP.NET Core API, which holds all secrets.
VITE_API_BASE_URL=http://localhost:5000/api/v1
