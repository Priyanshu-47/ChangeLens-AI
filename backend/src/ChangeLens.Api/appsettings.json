{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Ai": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 120
  },
  "ChangeSource": {
    "RootPath": "",
    "RepositoryPath": "data/demo-repository",
    "MaxImpactDepth": 2,
    "GitTimeoutSeconds": 15
  },
  "Analysis": {
    "QueueCapacity": 100,
    "MaxConcurrency": 2,
    "JobTimeoutSeconds": 600,
    "MaxRetries": 2,
    "RetryBackoffSeconds": 5,
    "RecoverOnStartup": true
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "RateLimit": {
    "AnalysisPermitLimit": 10,
    "AnalysisWindowSeconds": 60,
    "AnalysisQueueLimit": 4
  }
}
