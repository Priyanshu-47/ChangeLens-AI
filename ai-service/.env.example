# ChangeLens AI service — environment template (copy to .env and fill in).
# NEVER commit the real .env. All values are placeholders or safe defaults.

# Internal API shared secret — the ASP.NET Core backend sends this as X-Internal-Key.
INTERNAL_API_KEY=change-me-internal-key

# Provider selection: "gemini" (real LLM) or "mock" (deterministic local stand-in).
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini. Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name is configuration, never code (docs/llm-integration.md §7).
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Provider call timeout + bounded retries (429/5xx only, exponential backoff + jitter).
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional per-model pricing (USD per 1M tokens). Unset => no cost estimate returned.
GEMINI_INPUT_PRICE_PER_1M_USD=
GEMINI_OUTPUT_PRICE_PER_1M_USD=

# Analysis behaviour
AI_MAX_REPAIR_ATTEMPTS=2
AI_READINESS_PROBE=false
AI_MAX_EVIDENCE_CHARS=120000

# Logging
LOG_LEVEL=INFO
