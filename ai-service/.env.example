[TEMPLATE]
# ChangeLens AI service — environment template (copy to .env and fill in).
# NEVER commit the real .env. All values are placeholders or safe defaults.

# Internal API shared secret — the ASP.NET Core backend sends this as X-Internal-Key.
INTERNAL_API_KEY=change-me-internal-key

# Provider selection: "gemini" (real LLM) or "mock" (deterministic local stand-in).
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini. Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name is configuration, never code (docs/llm-integration.md §7).
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Provider call timeout + bounded retries (429/5xx only, exponential backoff + jitter).
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional per-model pricing (USD per 1M tokens). Unset => no cost estimate returned.
GEMINI_INPUT_PRICE_PER_1M_USD=
GEMINI_OUTPUT_PRICE_PER_1M_USD=

# Analysis behaviour
AI_MAX_REPAIR_ATTEMPTS=2
AI_READINESS_PROBE=false
AI_MAX_EVIDENCE_CHARS=120000
# Phase 3: automatically run hybrid retrieval to fill the evidence package when the
# backend request does not already contain retrieved documents.
AI_AUTO_RETRIEVE=true

# ── Phase 3: persistence (ai schema — owned by this service, ADR-0003) ──────────
# Same PostgreSQL instance as the backend; the ai schema is migrated at startup.
DATABASE_URL=postgresql+psycopg://changelens:changelens_dev_password@127.0.0.1:5433/changelens

# ── Phase 3: embeddings ─────────────────────────────────────────────────────────
# "gemini" (real embedding API, ~0 cost per 1k rows) or "mock" (deterministic
# vectors, $0, perfect for local dev and tests).
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Dimension must match the configured embedding model (text-embedding-004 -> 768).
# Changing the model requires a new migration + re-index (docs/llm-integration.md §2).
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_MAX_RETRIES=3
GEMINI_EMBEDDING_PRICE_PER_1M_USD=

# ── Phase 3: retrieval ──────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=50
RRF_K=60

# Logging
LOG_LEVEL=INFO
